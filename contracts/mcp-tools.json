  {
    "name": "mother_search_context",
    "description": "Search title/content locally with hybrid (default), semantic, or literal retrieval. Hybrid puts exact substring matches first. Missing or unavailable local models produce explicit literal fallback. Results are bounded previews with coverage metadata; resolve full records before relying on details. Retracted, superseded and cancelled records are excluded. Search never downloads a model or sends text remotely.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "mode": {
          "type": "string",
          "enum": [
            "hybrid",
            "semantic",
            "literal"
          ],
          "default": "hybrid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "memory",
            "decision",
            "task",
            "checkpoint",
            "artifact",
            "action"
          ]
        },
        "limit": {
          "default": 20,
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "query"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
