          "format": "uuid"
        },
        "memoryId": {
          "type": "string",
          "format": "uuid"
        },
        "contentBase64": {
          "type": "string",
          "maxLength": 2796204
        },
        "fileName": {
          "type": "string"
        },
        "mediaType": {
          "type": "string"
        },
        "sourceFileId": {
          "type": "string"
        }
      },
